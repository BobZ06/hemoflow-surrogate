__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Experiment artifacts - never commit these, they are reproducible from configs.
# Anchored with a leading slash: an unanchored `data/` also matches
# src/hemoflow/data/, which would silently drop a source package from the repo.
/artifacts/
/data/
/runs/
*.pt
*.ckpt
*.npz
!tests/fixtures/*.npz

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.DS_Store

# Anything dropped into this folder from a chat client - never belongs in the repo.
Claude outputs/
*.claude-download
